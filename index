        // ============================================
        // PESSOAS
        // ============================================
        function atualizarPessoas() {
            const tbody = document.getElementById('tabelaPessoas');
            const busca = document.getElementById('buscaPessoa').value.toLowerCase();

            const pessoasMap = new Map();
            dados.cadastros.forEach(c => {
                const key = c.nome.toLowerCase();
                if (!pessoasMap.has(key)) {
                    pessoasMap.set(key, {
                        nome: c.nome,
                        nascimento: c.nascimentoExibicao || formatarDataExibicao(c.nascimento),
                        genero: c.genero || 'Não informado',
                        responsavel: c.responsavel,
                        cidade: c.cidade,
                        atendimentos: [],
                        ultimoAtendimento: c.dataExibicao || c.data
                    });
                }
                const pessoa = pessoasMap.get(key);
                pessoa.atendimentos.push(c);
                const dataAtual = c.dataExibicao || c.data;
                if (dataAtual > pessoa.ultimoAtendimento) {
                    pessoa.ultimoAtendimento = dataAtual;
                }
            });

            let pessoas = Array.from(pessoasMap.values());

            if (busca) {
                pessoas = pessoas.filter(p => 
                    p.nome.toLowerCase().includes(busca) ||
                    p.responsavel.toLowerCase().includes(busca) ||
                    p.cidade.toLowerCase().includes(busca)
                );
            }

            document.getElementById('totalPessoas').textContent = pessoas.length;

            if (pessoas.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#999; padding:30px;">📭 Nenhuma pessoa encontrada</td></tr>`;
            } else {
                tbody.innerHTML = pessoas.map(p => `
                    <tr>
                        <td><strong>${p.nome}</strong></td>
                        <td>${p.nascimento}</td>
                        <td>${p.genero}</td>
                        <td>${p.responsavel}</td>
                        <td>${p.cidade}</td>
                        <td><span class="status-badge atendido">${p.atendimentos.length}</span></td>
                        <td>${p.ultimoAtendimento}</td>
                    </tr>
                `).join('');
            }
        }

