        function gerarGraficos() {
            // Assuntos
            const assuntos = {};
            dados.atendimentos.forEach(a => {
                const assuntosList = a.assunto.split('; ');
                assuntosList.forEach(ass => {
                    if (ass.trim()) {
                        assuntos[ass.trim()] = (assuntos[ass.trim()] || 0) + 1;
                    }
                });
            });
            const sortedAssuntos = Object.entries(assuntos).sort((a, b) => b[1] - a[1]).slice(0, 5);
            const assuntosDiv = document.getElementById('assuntosChart');
            if (sortedAssuntos.length === 0) {
                assuntosDiv.innerHTML = '<p style="color:#999; text-align:center; padding:15px 0;">Nenhum dado</p>';
            } else {
                const max = Math.max(...sortedAssuntos.map(a => a[1]));
                assuntosDiv.innerHTML = sortedAssuntos.map(([key, value]) => `
                    <div class="bar-item">
                        <span class="bar-label">${key.length > 22 ? key.substring(0, 22)+'…' : key}</span>
                        <div class="bar-track">
                            <div class="bar-fill blue" style="width: ${(value/max)*100}%;">${value}</div>
                        </div>
                    </div>
                `).join('');
            }

            // Cidades
            const cidades = {};
            dados.atendimentos.forEach(a => {
                cidades[a.cidade] = (cidades[a.cidade] || 0) + 1;
            });
            const sortedCidades = Object.entries(cidades).sort((a, b) => b[1] - a[1]).slice(0, 5);
            const cidadesDiv = document.getElementById('cidadesChart');
            if (sortedCidades.length === 0) {
                cidadesDiv.innerHTML = '<p style="color:#999; text-align:center; padding:15px 0;">Nenhum dado</p>';
            } else {
                const max = Math.max(...sortedCidades.map(c => c[1]));
                cidadesDiv.innerHTML = sortedCidades.map(([key, value]) => `
                    <div class="bar-item">
                        <span class="bar-label">${key}</span>
                        <div class="bar-track">
                            <div class="bar-fill green" style="width: ${(value/max)*100}%;">${value}</div>
                        </div>
                    </div>
                `).join('');
            }

            // Violações
            const violacoes = {};
            const termosViolacao = ['Violência', 'Abuso', 'Abandono', 'Negligência'];
            dados.atendimentos.forEach(a => {
                const assuntosList = a.assunto.split('; ');
                assuntosList.forEach(ass => {
                    if (termosViolacao.some(t => ass.includes(t))) {
                        violacoes[ass.trim()] = (violacoes[ass.trim()] || 0) + 1;
                    }
                });
            });
            const sortedViolacoes = Object.entries(violacoes).sort((a, b) => b[1] - a[1]).slice(0, 5);
            const violacoesDiv = document.getElementById('violacoesChart');
            if (sortedViolacoes.length === 0) {
                violacoesDiv.innerHTML = '<p style="color:#999; text-align:center; padding:15px 0;">Nenhuma violação</p>';
            } else {
                const max = Math.max(...sortedViolacoes.map(v => v[1]));
                violacoesDiv.innerHTML = sortedViolacoes.map(([key, value]) => `
                    <div class="bar-item">
                        <span class="bar-label">${key.length > 22 ? key.substring(0, 22)+'…' : key}</span>
                        <div class="bar-track">
                            <div class="bar-fill red" style="width: ${(value/max)*100}%;">${value}</div>
                        </div>
                    </div>
                `).join('');
            }

            // Gênero
            const generos = {};
            dados.cadastros.forEach(c => {
                const gen = c.genero || 'Não informado';
                generos[gen] = (generos[gen] || 0) + 1;
            });
            const generosDiv = document.getElementById('generoChart');
            if (Object.keys(generos).length === 0) {
                generosDiv.innerHTML = '<p style="color:#999; text-align:center; padding:15px 0;">Nenhum dado</p>';
            } else {
                const total = Object.values(generos).reduce((a, b) => a + b, 0);
                generosDiv.innerHTML = Object.entries(generos).map(([key, value]) => `
                    <div class="bar-item">
                        <span class="bar-label">${key}</span>
                        <div class="bar-track">
                            <div class="bar-fill purple" style="width: ${(value/total)*100}%;">${value} (${Math.round((value/total)*100)}%)</div>
                        </div>
                    </div>
                `).join('');
            }
        }

