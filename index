        // ============================================
        // PDF
        // ============================================
        function carregarPDF() {
            document.getElementById('pdfModal').classList.add('active');
            document.getElementById('pdfPreview').innerHTML = '';
            document.getElementById('pdfInput').value = '';
        }

        function fecharModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function processarPDF() {
            const fileInput = document.getElementById('pdfInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                alert('⚠️ Selecione um arquivo PDF.');
                return;
            }

            const file = fileInput.files[0];
            const reader = new FileReader();
            
            reader.onload = function(e) {
                try {
                    const text = e.target.result;
                    const linhas = text.split('\n');
                    let dadosExtraidos = {
                        nome: '', data: '', nascimento: '', responsavel: '',
                        endereco: '', telefone: '', assunto: '', tipo: ''
                    };

                    const padroes = {
                        nome: [/Nome[: ]*([^\n]+)/i, /Criança[: ]*([^\n]+)/i, /Adolescente[: ]*([^\n]+)/i],
                        data: [/Data[: ]*([\d\/]+)/i, /(\d{2}\/\d{2}\/\d{4})/],
                        nascimento: [/Nascimento[: ]*([\d\/]+)/i, /Nasc[: ]*([\d\/]+)/i],
                        responsavel: [/Respons[áa]vel[: ]*([^\n]+)/i, /Resp[: ]*([^\n]+)/i],
                        endereco: [/Endere[çc]o[: ]*([^\n]+)/i, /End[: ]*([^\n]+)/i],
                        telefone: [/Telefone[: ]*([^\n]+)/i, /Tel[: ]*([^\n]+)/i],
                        assunto: [/Assunto[: ]*([^\n]+)/i],
                        tipo: [/Tipo de atendimento[: ]*([^\n]+)/i]
                    };

                    linhas.forEach(linha => {
                        const l = linha.trim();
                        if (!l) return;

                        for (const [campo, padroesList] of Object.entries(padroes)) {
                            if (!dadosExtraidos[campo]) {
                                for (const padrao of padroesList) {
                                    const match = l.match(padrao);
                                    if (match && match[1]) {
                                        dadosExtraidos[campo] = match[1].trim();
                                        break;
                                    }
                                }
                            }
                        }
                    });

                    // Preenche formulário
                    if (dadosExtraidos.nome) document.getElementById('nome').value = dadosExtraidos.nome;
                    if (dadosExtraidos.responsavel) document.getElementById('responsavel').value = dadosExtraidos.responsavel;
                    if (dadosExtraidos.endereco) document.getElementById('endereco').value = dadosExtraidos.endereco;
                    if (dadosExtraidos.telefone) document.getElementById('telefone').value = dadosExtraidos.telefone;

                    if (dadosExtraidos.data) {
                        const partes = dadosExtraidos.data.match(/(\d{2})\/(\d{2})\/(\d{4})/);
                        if (partes) {
                            document.getElementById('dataDia').value = parseInt(partes[1]);
                            document.getElementById('dataMes').value = parseInt(partes[2]);
                            document.getElementById('dataAno').value = parseInt(partes[3]);
                        }
                    }

                    if (dadosExtraidos.nascimento) {
                        const partes = dadosExtraidos.nascimento.match(/(\d{2})\/(\d{2})\/(\d{4})/);
                        if (partes) {
                            document.getElementById('nascDia').value = parseInt(partes[1]);
                            document.getElementById('nascMes').value = parseInt(partes[2]);
                            document.getElementById('nascAno').value = parseInt(partes[3]);
                        }
                    }

                    if (dadosExtraidos.assunto) {
                        const assuntoLower = dadosExtraidos.assunto.toLowerCase();
                        document.querySelectorAll('input[name="assunto"]').forEach(cb => {
                            if (assuntoLower.includes(cb.value.toLowerCase())) {
                                cb.checked = true;
                            }
                        });
                        if (!document.querySelector('input[name="assunto"]:checked')) {
                            document.querySelector('input[name="assunto"][value="Outro"]').checked = true;
                            document.getElementById('assuntoOutro').value = dadosExtraidos.assunto;
                        }
                    }

                    if (dadosExtraidos.tipo) {
                        const tipoLower = dadosExtraidos.tipo.toLowerCase();
                        document.querySelectorAll('input[name="tipoAtendimento"]').forEach(r => {
                            if (tipoLower.includes(r.value.toLowerCase())) {
                                r.checked = true;
                            }
                        });
                        document.querySelectorAll('input[name="tipoAtendimento2"]').forEach(r => {
                            if (tipoLower.includes(r.value.toLowerCase())) {
                                r.checked = true;
                            }
                        });
                    }

                    document.getElementById('pdfPreview').innerHTML = `
                        <div style="background:#e8f5e9; padding:14px; border-radius:8px; border-left:4px solid #2e7d32;">
                            <p style="color:#2e7d32; font-weight:600;">✅ Dados extraídos com sucesso!</p>
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:3px; margin-top:8px; font-size:13px;">
                                <span><strong>Nome:</strong> ${dadosExtraidos.nome || '—'}</span>
                                <span><strong>Data:</strong> ${dadosExtraidos.data || '—'}</span>
                                <span><strong>Nascimento:</strong> ${dadosExtraidos.nascimento || '—'}</span>
                                <span><strong>Responsável:</strong> ${dadosExtraidos.responsavel || '—'}</span>
                                <span><strong>Telefone:</strong> ${dadosExtraidos.telefone || '—'}</span>
                                <span><strong>Assunto:</strong> ${dadosExtraidos.assunto || '—'}</span>
                            </div>
                        </div>
                    `;
                    
                    fecharModal('pdfModal');
                    alert('📄 Dados extraídos do PDF com sucesso!');
                } catch (error) {
                    alert('❌ Erro ao processar o PDF.');
                    console.error(error);
                }
            };

            reader.onerror = function() {
                alert('❌ Erro ao ler o arquivo.');
            };

            reader.readAsText(file);
        }

        // ============================================
        // EXPORTAR EXCEL
        // ============================================
        function exportarExcel() {
            if (dados.cadastros.length === 0) {
                alert('❌ Nenhum dado para exportar.');
                return;
            }

            let csv = 'Data,Nome,Nascimento,Responsável,Telefone,Endereço,Cidade,Assunto,Tipo,Observação\n';
            dados.cadastros.forEach(c => {
                csv += `"${c.dataExibicao || formatarDataExibicao(c.data)}","${c.nome}","${c.nascimentoExibicao || formatarDataExibicao(c.nascimento)}","${c.responsavel}","${c.telefone}","${c.endereco}","${c.cidade}","${c.assunto}","${c.tipoAtendimento}","${c.observacao}"\n`;
            });

            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `cadastros_${new Date().toISOString().split('T')[0]}.csv`;
            link.click();
            URL.revokeObjectURL(link.href);
        }

        // ============================================
        // INICIALIZAÇÃO
        // ============================================
        document.getElementById('dataAtual').textContent = new Date().toLocaleDateString('pt-BR', {
            day: '2-digit', month: 'short', year: 'numeric'
        });
        document.getElementById('dataAno').value = '2026';

        carregarDados();

        console.log('🏛️ Sistema Conselho Tutelar v2.0');
        console.log(`📊 ${dados.cadastros.length} cadastros, ${dados.atendimentos.length} atendimentos`);
    </script>
