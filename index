    <script>
        // ============================================
        // BANCO DE DADOS
        // ============================================
        let dados = {
            cadastros: [],
            atendimentos: []
        };

        function carregarDados() {
            const stored = localStorage.getItem('conselhoDados_v3');
            if (stored) {
                dados = JSON.parse(stored);
            }
            atualizarTabelas();
            atualizarDashboard();
            atualizarMenus();
        }

        function salvarDados() {
            localStorage.setItem('conselhoDados_v3', JSON.stringify(dados));
            atualizarTabelas();
            atualizarDashboard();
            atualizarMenus();
        }

        // ============================================
        // MENU
        // ============================================
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.querySelector('.sidebar-overlay').classList.toggle('active');
        }

        function showSection(sectionId) {
            document.getElementById('sidebar').classList.remove('open');
            document.querySelector('.sidebar-overlay').classList.remove('active');

            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.getElementById(sectionId).classList.add('active');

            document.querySelectorAll('.sidebar-menu .menu-item').forEach(m => m.classList.remove('active'));
            document.querySelector(`.sidebar-menu .menu-item[onclick="showSection('${sectionId}')"]`).classList.add('active');

            const titles = {
                'dashboard': '📊 Dashboard',
                'cadastro': '📝 Atendimento',
                'atendimentos': '📋 Histórico',
                'pessoas': '👤 Pessoas',
                'relatorios': '📈 Relatórios'
            };
            document.getElementById('pageTitle').textContent = titles[sectionId] || 'Sistema';

            if (sectionId === 'dashboard') atualizarDashboard();
            if (sectionId === 'pessoas') atualizarPessoas();
        }

        function atualizarMenus() {
            document.getElementById('menuTotal').textContent = dados.cadastros.length;
            document.getElementById('menuAtendimentos').textContent = dados.atendimentos.length;
            document.getElementById('menuPessoas').textContent = dados.cadastros.length;
            document.getElementById('totalCadastros').textContent = dados.cadastros.length;
            document.getElementById('totalAtendimentos').textContent = dados.atendimentos.length;
            document.getElementById('totalPessoas').textContent = dados.cadastros.length;
        }

        // ============================================
        // FORMATAÇÃO
        // ============================================
        function formatarDataParaInput(dia, mes, ano) {
            if (!dia || !mes || !ano) return '';
            return `${ano}-${String(mes).padStart(2, '0')}-${String(dia).padStart(2, '0')}`;
        }

        function formatarDataExibicao(data) {
            if (!data) return '-';
            try {
                const d = new Date(data);
                return d.toLocaleDateString('pt-BR');
            } catch(e) {
                return data;
            }
        }

        function formatarDataCompleta(dia, mes, ano) {
            if (!dia || !mes || !ano) return '';
            return `${String(dia).padStart(2, '0')}/${String(mes).padStart(2, '0')}/${ano}`;
        }

        // ============================================
        // CADASTRO
        // ============================================
        function salvarCadastro() {
            const nome = document.getElementById('nome').value.trim();
            if (!nome) {
                alert('⚠️ Preencha o nome da criança/adolescente.');
                document.getElementById('nome').focus();
                return;
            }

            const responsavel = document.getElementById('responsavel').value.trim();
            if (!responsavel) {
                alert('⚠️ Preencha o nome do responsável.');
                document.getElementById('responsavel').focus();
                return;
            }

            const endereco = document.getElementById('endereco').value.trim();
            if (!endereco) {
                alert('⚠️ Preencha o endereço.');
                document.getElementById('endereco').focus();
                return;
            }

            const dia = document.getElementById('dataDia').value;
            const mes = document.getElementById('dataMes').value;
            const ano = document.getElementById('dataAno').value || '2026';
            const dataAtendimento = formatarDataParaInput(dia, mes, ano);

            if (!dia || !mes || !ano) {
                alert('⚠️ Preencha a data de atendimento completa.');
                return;
            }

            const nDia = document.getElementById('nascDia').value;
            const nMes = document.getElementById('nascMes').value;
            const nAno = document.getElementById('nascAno').value;
            const dataNascimento = formatarDataParaInput(nDia, nMes, nAno);

            if (!nDia || !nMes || !nAno) {
                alert('⚠️ Preencha a data de nascimento completa.');
                return;
            }

            // Tipo atendimento
            let tipoAtendimento = '';
            document.querySelectorAll('input[name="tipoAtendimento"]').forEach(r => {
                if (r.checked) {
                    tipoAtendimento = r.value;
                    if (r.value === 'Outros') {
                        const outros = document.getElementById('tipoAtendimentoOutros').value.trim();
                        if (outros) tipoAtendimento += `: ${outros}`;
                    }
                }
            });

            let tipoAtendimento2 = '';
            document.querySelectorAll('input[name="tipoAtendimento2"]').forEach(r => {
                if (r.checked) {
                    tipoAtendimento2 = r.value;
                    if (r.value === 'Outro') {
                        const outros = document.getElementById('tipoAtendimento2Outros').value.trim();
                        if (outros) tipoAtendimento2 += `: ${outros}`;
                    }
                }
            });

            // Assunto
            const assuntosSelecionados = [];
            document.querySelectorAll('input[name="assunto"]:checked').forEach(cb => {
                let valor = cb.value;
                if (cb.value === 'Outro') {
                    const outro = document.getElementById('assuntoOutro').value.trim();
                    if (outro) valor = outro;
                }
                assuntosSelecionados.push(valor);
            });

            if (assuntosSelecionados.length === 0) {
                alert('⚠️ Selecione pelo menos um assunto.');
                return;
            }

            const assunto = assuntosSelecionados.join('; ');

            // Extrair cidade do endereço
            let cidade = 'Não informado';
            const partesEndereco = endereco.split(',');
            if (partesEndereco.length > 0) {
                cidade = partesEndereco[partesEndereco.length - 1].trim();
                if (!cidade) cidade = 'Não informado';
            }

            const cadastro = {
                id: Date.now(),
                data: dataAtendimento,
                dataExibicao: formatarDataCompleta(dia, mes, ano),
                nome: nome,
                nascimento: dataNascimento,
                nascimentoExibicao: formatarDataCompleta(nDia, nMes, nAno),
                genero: 'Não informado',
                responsavel: responsavel,
                telefone: document.getElementById('telefone').value.trim(),
                endereco: endereco,
                cidade: cidade,
                assunto: assunto,
                tipoAtendimento: tipoAtendimento || tipoAtendimento2 || 'Presencial',
                observacao: document.getElementById('observacao').value.trim(),
                dataCadastro: new Date().toISOString()
            };

            // Verifica duplicidade
            const duplicado = dados.cadastros.find(c => 
                c.nome.toLowerCase() === cadastro.nome.toLowerCase() && 
                c.responsavel.toLowerCase() === cadastro.responsavel.toLowerCase()
            );

            if (duplicado) {
                if (!confirm(`⚠️ Já existe um cadastro para ${cadastro.nome} com responsável ${cadastro.responsavel}. Deseja adicionar mesmo assim?`)) {
                    return;
                }
            }

            dados.cadastros.push(cadastro);
            
            dados.atendimentos.push({
                id: Date.now(),
                idCadastro: cadastro.id,
                data: cadastro.data,
                dataExibicao: cadastro.dataExibicao,
                nome: cadastro.nome,
                assunto: cadastro.assunto,
                tipo: cadastro.tipoAtendimento,
                cidade: cadastro.cidade,
                status: 'Atendido'
            });

            salvarDados();
            limparFormulario();
            alert(`✅ Cadastro de ${cadastro.nome} realizado com sucesso!`);
        }

        function limparFormulario() {
            document.getElementById('cadastroForm').reset();
            document.getElementById('dataDia').value = '';
            document.getElementById('dataMes').value = '';
            document.getElementById('dataAno').value = '2026';
            document.getElementById('nascDia').value = '';
            document.getElementById('nascMes').value = '';
            document.getElementById('nascAno').value = '';
            document.getElementById('tipoAtendimentoOutros').value = '';
            document.getElementById('tipoAtendimento2Outros').value = '';
            document.getElementById('assuntoOutro').value = '';
            document.getElementById('observacao').value = '';
        }

        // ============================================
        // TABELAS
        // ============================================
        function atualizarTabelas() {
            // Cadastros
            const tbodyCadastros = document.getElementById('tabelaCadastros');
            if (dados.cadastros.length === 0) {
                tbodyCadastros.innerHTML = `<tr><td colspan="7" style="text-align:center; color:#999; padding:30px;">📭 Nenhum cadastro realizado</td></tr>`;
            } else {
                tbodyCadastros.innerHTML = dados.cadastros.slice().reverse().slice(0, 15).map(c => `
                    <tr>
                        <td>${c.dataExibicao || formatarDataExibicao(c.data)}</td>
                        <td><strong>${c.nome}</strong></td>
